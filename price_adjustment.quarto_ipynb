      "id": "bc9bb171"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Loading and Cleaning\n",
        "## Load And Clean"
      ],
      "id": "8368b845"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: load_data\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import statsmodels.formula.api as smf\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import matplotlib.dates as mdates\n",
        "\n",
        "# Load Sales Files\n",
        "res = pd.read_csv('data/MLS_Residential_Sales.csv').assign(segment='Residential')\n",
        "multi = pd.read_csv('data/Multi-Family_MLS_Export.csv').assign(segment='Multi-Family')\n",
        "land = pd.read_csv('data/MLS_Land_Sales.csv').assign(segment='Land Sales')\n",
        "\n",
        "# Stack all sales into one \"Long\" dataframe\n",
        "all_sales = pd.concat([res, multi, land], ignore_index=True)\n",
        "\n",
        "# Load Parcel Characteristics\n",
        "parcels = pd.read_csv('data/parcel_export.csv')\n",
        "\n",
        "# Attach Parcel data to Sales data\n",
        "df_combined = pd.merge(all_sales, parcels, left_on='Parcel Number', right_on='ParcelId', how='left')\n",
        "\n",
        "# Convert Sale Date to a format Python understands\n",
        "df_combined['Sold Date'] = pd.to_datetime(df_combined['Sold Date'])\n",
        "\n",
        "print(f\"Total Sales Loaded: {len(df_combined)}\")"
      ],
      "id": "load_data",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Adjust Prices & Create Time Variables\n",
        "\n",
        "## Adjust Prices"
      ],
      "id": "c8a5be42"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: adjust_prices\n",
        "# Concession Adjustment\n",
        "df_combined['Adj_Price'] = df_combined['Sold Price'] - df_combined['Concessions Amount'].fillna(0)\n",
        "\n",
        "# Filter for math safety\n",
        "df_combined = df_combined[df_combined['Adj_Price'] > 0].copy()\n",
        "df_combined['ln_Price'] = np.log(df_combined['Adj_Price'])"
      ],
      "id": "adjust_prices",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Rolling Median Spline Dates"
      ],
      "id": "9a89d240"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: Spline Visualization\n",
        "# Rolling Median Method\n",
        "df_combined['YearMonth'] = df_combined['Sold Date'].dt.to_period('M')\n",
        "monthly_summary = df_combined.groupby('YearMonth')['ln_Price'].median()\n",
        "\n",
        "# Plot to visually identify the knots\n",
        "monthly_summary.plot(style='o-')"
      ],
      "id": "Spline-Visualization",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Piecewise Regression Spline dates\n",
        "\n",
        "Documentation on this"
      ],
      "id": "ac7af709"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: piecewise_regression\n",
        "import pwlf\n",
        "\n",
        "# Setup the numeric timeline\n",
        "start_date = pd.Timestamp('2021-01-01') # Adjusted for 36 months\n",
        "df_combined['days_since'] = (df_combined['Sold Date'] - start_date).dt.days\n",
        "\n",
        "# Fit the model for n segments (n-1 internal knots)\n",
        "x = df_combined['days_since'].values\n",
        "y = df_combined['ln_Price'].values\n",
        "model = pwlf.PiecewiseLinFit(x, y)\n",
        "knots = model.fit(4) # Controls the number of knots(currently 3)\n",
        "\n",
        "# Convert all knots to Timestamps\n",
        "best_dates = [start_date + pd.Timedelta(days=int(k)) for k in knots]\n",
        "\n",
        "# Print all internal splines\n",
        "print(\"--- 36-Month Market Inflection Points ---\")\n",
        "for i, d in enumerate(best_dates[1:-1], 1):\n",
        "    print(f\"Spline {i}: {d.date()}\")"
      ],
      "id": "piecewise_regression",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Global vs. Sub-Market Splines Pros{background-color=\"#adffc1ff\"}\n",
        "\n",
        "::: columns\n",
        "::: {.column width=\"50%\"}\n",
        "### **Global**\n",
        "\n",
        "* **Statistical Stability.** Uses 7,000+ sales to find a \"clean\" signal; less prone to outlier noise.\n",
        "* **Direct Comparability.** Easy to compare how different segments reacted to the *same* dates.\n",
        "\n",
        ":::\n",
        "\n",
        "::: {.column width=\"50%\"}\n",
        "### **Segmented**\n",
        "\n",
        "* **Market Sensitivity.** Captures the 3–6 month lag often seen in Land/Commercial sectors.\n",
        "* **Mathematical Precision.** Minimizes the \"Residual Sum of Squares\" for each specific data pool.\n",
        ":::\n",
        ":::\n",
        "\n",
        "## Global vs. Sub-Market Splines Cons{background-color=\"#ffb6adff\"}\n",
        "\n",
        "::: columns\n",
        "::: {.column width=\"50%\"}\n",
        "### **Global**\n",
        "\n",
        "* **Temporal Blur.** May miss specific \"lags\" in slower markets like Land or Multi-Family.\n",
        "* **Assumption.** Forces a single \"shock date\" on all asset classes regardless of reality.\n",
        ":::\n",
        "\n",
        "::: {.column width=\"50%\"}\n",
        "### **Segmented**\n",
        "\n",
        "* **Overfitting Risk.** Small datasets (Multi-Family) may \"break\" at random, non-economic points.\n",
        "* **Complexity.** Harder to defend why \"Time 1\" starts in May for houses but September for land.\n",
        ":::\n",
        ":::\n",
        "\n",
        "## My Thoughts {background-color=\"#adceffff\"}\n",
        "Use Global Splines anchored to the Residential market. Consistency > Precision. It provides a stable framework to measure how different sectors responded to the same macro-economic milestones.\n",
        "\n",
        "\n",
        "## Adjust Prices & Create Time Variables"
      ],
      "id": "6ec2fea8"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: spline_adjustments\n",
        "\n",
        "# Manually input the dates found in the \"Piecewise Regression\" step\n",
        "# For 36 months, 4 splines is standard.\n",
        "start_date = pd.Timestamp('2021-01-01')\n",
        "spline1    = pd.Timestamp('2023-06-20') \n",
        "spline2    = pd.Timestamp('2023-08-21')\n",
        "spline3    = pd.Timestamp('2024-01-16')\n",
        "lien_date  = pd.Timestamp('2026-01-01')\n",
        "\n",
        "def get_months_precise(sale_date, start, end):\n",
        "    if pd.isna(sale_date) or sale_date <= start: \n",
        "        return 0\n",
        "    # Calculate overlap: how much of the sale's timeline falls in this bucket\n",
        "    effective_start = start\n",
        "    effective_end = min(sale_date, end)\n",
        "    \n",
        "    if effective_end <= effective_start:\n",
        "        return 0\n",
        "        \n",
        "    return (effective_end - effective_start).days / 30.44\n",
        "\n",
        "# Create the Time Variables (Matches the time_vars list in the regression cell)\n",
        "df_combined['Time1'] = df_combined['Sold Date'].apply(lambda x: get_months_precise(x, start_date, spline1))\n",
        "df_combined['Time2'] = df_combined['Sold Date'].apply(lambda x: get_months_precise(x, spline1, spline2))\n",
        "df_combined['Time3'] = df_combined['Sold Date'].apply(lambda x: get_months_precise(x, spline2, spline3))\n",
        "df_combined['Time5'] = df_combined['Sold Date'].apply(lambda x: get_months_precise(x, spline4, lien_date))"
      ],
      "id": "spline_adjustments",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# The Time Trend Regression\n",
        "\n",
        "## Regression"
      ],
      "id": "ade67fa6"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: segmented_regression\n",
        "import statsmodels.formula.api as smf\n",
        "import pandas as pd\n",
        "\n",
        "# Define the targets for the loop\n",
        "segments = ['Residential', 'Multi-Family', 'Land Sales']\n",
        "# This list matches your 4-knot (5-segment) PWLF model\n",
        "time_vars = ['Time1', 'Time2', 'Time3', 'Time5']\n",
        "\n",
        "# Dictionary to store results for the next \"Apply Adjustments\" step\n",
        "market_coefficients = {}\n",
        "\n",
        "# Ensure log of GLA exists for the structural controls\n",
        "df_combined['ln_GLA'] = np.log(df_combined['Total SqFt'].replace(0, np.nan))\n",
        "\n",
        "for seg in segments:\n",
        "    # Filter for the specific market segment\n",
        "    df_seg = df_combined[df_combined['segment'] == seg].copy()\n",
        "    \n",
        "    # Identify which Time variables actually exist in the dataframe\n",
        "    # (Prevents errors if you change knot counts later)\n",
        "    existing_time = [v for v in time_vars if v in df_seg.columns]\n",
        "    time_str = \" + \".join(existing_time)\n",
        "    \n",
        "    # 2Build the Formula\n",
        "    if seg != 'Land Sales':\n",
        "        # Residential/Multi use Square Foot and Age controls\n",
        "        df_seg = df_seg.dropna(subset=['ln_GLA', 'Year Built'])\n",
        "        formula = f\"ln_Price ~ ln_GLA + Q('Year Built') + {time_str}\"\n",
        "    else:\n",
        "        # Land only uses the Time Trend\n",
        "        formula = f\"ln_Price ~ {time_str}\"\n",
        "\n",
        "    # Run the Model\n",
        "    if len(df_seg) > 25: # Ensure enough data for 5+ variables\n",
        "        try:\n",
        "            model = smf.ols(formula=formula, data=df_seg).fit()\n",
        "            \n",
        "            # CRITICAL: Save the parameters for the adjustment step later\n",
        "            market_coefficients[seg] = model.params\n",
        "            \n",
        "            print(f\"\\n{'='*50}\")\n",
        "            print(f\" MARKET SEGMENT: {seg.upper()} \")\n",
        "            print(f\"{'='*50}\")\n",
        "            print(f\"Obs: {len(df_seg)} | R-Squared: {model.rsquared:.3f}\")\n",
        "            \n",
        "            # Format Results for the Slide\n",
        "            results_df = pd.DataFrame({\n",
        "                'Coefficient': model.params[existing_time],\n",
        "                'P-Value': model.pvalues[existing_time]\n",
        "            })\n",
        "            \n",
        "            # Add Significance 'Stars' for quick reading during the presentation\n",
        "            results_df['Sig'] = results_df['P-Value'].apply(\n",
        "                lambda x: '***' if x < 0.01 else ('**' if x < 0.05 else ('*' if x < 0.1 else 'ns'))\n",
        "            )\n",
        "            \n",
        "            print(results_df.round(5))\n",
        "            \n",
        "        except Exception as e:\n",
        "            print(f\"Error running regression for {seg}: {e}\")\n",
        "    else:\n",
        "        print(f\"Skipping {seg}: Insufficient data ({len(df_seg)} obs).\")"
      ],
      "id": "segmented_regression",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Apply Adjustments to Lien Date\n",
        "## Next Steps\n",
        "Better Segments?\n",
        "- AREA Code. How far to break down?\n",
        "- Look at UMAP\n",
        "- Pricing tiers\n",
        "Have Lucca set up the other models\n",
        "\n",
        "## Lien Data Adjustments"
      ],
      "id": "52855fbe"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: apply_trend\n",
        "\n",
        "def calculate_trended_price(row):\n",
        "    seg = row['segment']\n",
        "    if seg not in market_coefficients:\n",
        "        return row['Adj_Price']\n",
        "    \n",
        "    betas = market_coefficients[seg]\n",
        "    \n",
        "    # Define the max capacity of each bucket (months)\n",
        "    limits = {\n",
        "        'Time1': (spline1 - start_date).days / 30.44,\n",
        "        'Time2': (spline2 - spline1).days / 30.44,\n",
        "        'Time3': (spline3 - spline2).days / 30.44,\n",
        "        'Time5': (lien_date - spline4).days / 30.44\n",
        "    }\n",
        "    \n",
        "    # Calculate adjustment: (Max months in bucket - Months used by sale) * Beta\n",
        "    # This brings the sale price forward to the Lien Date environment.\n",
        "    adjustment_log = 0\n",
        "    for t_var in limits.keys():\n",
        "        if t_var in betas:\n",
        "            remaining_months = max(0, limits[t_var] - row.get(t_var, 0))\n",
        "            adjustment_log += betas[t_var] * remaining_months\n",
        "    \n",
        "    return row['Adj_Price'] * np.exp(adjustment_log)\n",
        "\n",
        "df_combined['Trended_Price'] = df_combined.apply(calculate_trended_price, axis=1)"
      ],
      "id": "apply_trend",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Vizualization\n",
        "## Next Steps\n",
        "- ANOVA Test (For Ryan)?\n",
        "- Different Vizualization\n",
        "\n",
        "## Vizualizations"
      ],
      "id": "29344bca"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: trend_visualization_refined\n",
        "#| code-fold: true\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import matplotlib.dates as mdates\n",
        "\n",
        "# Data Preparation & Outlier Cleaning\n",
        "df_plot = df_combined[\n",
        "    (df_combined['segment'] == 'Residential') & \n",
        "    (df_combined['Total SqFt'] > 100)\n",
        "].copy()\n",
        "\n",
        "df_plot['Price_SqFt_Original'] = df_plot['Adj_Price'] / df_plot['Total SqFt']\n",
        "df_plot['Price_SqFt_Trended'] = df_plot['Trended_Price'] / df_plot['Total SqFt']\n",
        "\n",
        "# Auto-zoom: Filter for 98% of the data to remove extreme pricing outliers\n",
        "y_limit = df_plot['Price_SqFt_Original'].quantile(0.98)\n",
        "df_plot = df_plot[df_plot['Price_SqFt_Original'] < y_limit]\n",
        "\n",
        "# Numeric conversion for mapping\n",
        "df_plot['date_num'] = mdates.date2num(df_plot['Sold Date'])\n",
        "\n",
        "# Plotting\n",
        "plt.figure(figsize=(16, 8))\n",
        "\n",
        "# Original Market (The \"Before\" - showing the volatility)\n",
        "sns.regplot(data=df_plot, x='date_num', y='Price_SqFt_Original', \n",
        "            scatter_kws={'alpha':0.08, 'color':'gray', 's':10}, \n",
        "            line_kws={'color':'#e74c3c', 'label':'Original Market (Volatile)', 'linewidth':3}, \n",
        "            lowess=True)\n",
        "\n",
        "# Trended Market (The \"After\" - showing the stabilization)\n",
        "sns.regplot(data=df_plot, x='date_num', y='Price_SqFt_Trended', \n",
        "            scatter=False, \n",
        "            line_kws={'color':'#3498db', 'label':'Trended to Lien Date (Stabilized)', 'linewidth':4}, \n",
        "            lowess=False) \n",
        "\n",
        "# Visual Anchors (The Splines)\n",
        "spline_list = [spline1, spline2, spline3, spline4]\n",
        "for s in spline_list:\n",
        "    plt.axvline(mdates.date2num(s), color='black', linestyle='--', alpha=0.3, label='_nolegend_')\n",
        "\n",
        "#  Formatting\n",
        "ax = plt.gca()\n",
        "ax.xaxis.set_major_formatter(mdates.DateFormatter('%b %Y'))\n",
        "plt.ylim(0, y_limit) \n",
        "plt.title('Market Stabilization: Removing the Time Variable', fontsize=20, pad=20)\n",
        "plt.ylabel('Price per Square Foot', fontsize=14)\n",
        "plt.xlabel('Sale Date', fontsize=14)\n",
        "plt.legend(loc='upper left', fontsize=12, frameon=True)\n",
        "plt.grid(axis='y', alpha=0.2)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "trend_visualization_refined",
      "execution_count": null,
      "outputs": []
    }
