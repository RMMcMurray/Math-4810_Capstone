   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['List Number', 'Agency Name', 'Agency Phone', 'Agency Email', 'Listing Agent', 'Listing Agent Phone', 'Listing Agent Email', 'Co-Listing Agent', 'Property Type', 'Card Format', 'Book Section', 'Selling Agency', 'Selling Agency Phone', 'Selling Agency Email', 'Selling Agent', 'Selling Agent Phone', 'Selling Agent Email', 'Co-Selling Agent', 'End Date', 'Sub Type', 'Listing Date', 'Sold Date', 'Under Contract Date', 'Fallthrough Date', 'Status', 'Status Change Date', 'Withdrawal Date', 'Cancel Date', 'Contingent', 'Contingent Remarks', 'Original List Price', 'List Price', 'Sold Price', 'How Sold', 'MLS Area', 'St. #', 'St. Dir.', 'Street Name', 'Address 2', 'Street Direction Sfx', 'Street Suffix', 'City', 'State/Province', 'County', 'Postal Code', 'Total SqFt', 'Basement SqFt', 'Main SqFt', 'Upstairs SqFt', 'Year Built', 'Lot Dimensions', 'Lot Acres', 'Total Bedrooms', 'Full Baths', 'Half Baths', 'Garage Type', 'Zoned', 'Total Taxes', 'Subdivision', 'Public Remarks', 'Private Remarks', 'Parcel Number', 'Directions', 'Owner', 'Tax Serial #', 'mod_timestamp', 'For Sale or Rent', 'HOA', 'Basement', 'Fireplaces', 'Square Foot Source', 'PUD', 'Elementary', 'Senior Community', 'Jr. High', 'Sr. High', 'Listing Type', 'Sold Price Per/SqFt', 'HOA Dues $', 'Garage Capacity', 'Special Taxes (SID)$', 'Lofts', 'Concessions', 'Financing Remarks', 'HOA Dues Frequency', 'Owner/Agent', 'Marketing Begin Date', 'Delayed Marketing Exempt Listing', 'Concessions Amount', 'Concessions Available', 'Photo URL', 'Days on Market', 'Rooms', 'Features', 'Bsmt % Finish', 'Fireplaces2', 'Kitchens', 'Laundry', '3/4 Baths', 'Full Baths3', 'Concessions4', 'Parcel ID Check', 'Road Condition', 'Accessability', 'Address']\n"
     ]
    }
   ],
   "source": [
    "print(list(land_sales_df.columns))\n",
    "\n",
    "TARGET = \"Sold Price\"\n",
    "\n",
    "# Drops Unwanted Columns\n",
    "DROP_COLS = [\n",
    "    # IDs / Keys\n",
    "    \"List Number\", \"Parcel Number\", \"Tax Serial #\", \"Parcel ID Check\",\n",
    "    \"St. #\", \"Address\", \"Address 2\", \"Postal Code\",\n",
    "\n",
    "    # Agents / Agencies / PII\n",
    "    \"Agency Name\", \"Agency Phone\", \"Agency Email\",\n",
    "    \"Listing Agent\", \"Listing Agent Phone\", \"Listing Agent Email\",\n",
    "    \"Co-Listing Agent\",\n",
    "    \"Selling Agency\", \"Selling Agency Phone\", \"Selling Agency Email\",\n",
    "    \"Selling Agent\", \"Selling Agent Phone\", \"Selling Agent Email\",\n",
    "    \"Co-Selling Agent\", \"Owner\",\n",
    "\n",
    "    # URLs / Metadata\n",
    "    \"Photo URL\", \"mod_timestamp\", \"Card Format\", \"Book Section\",\n",
    "\n",
    "    # Directions / Remarks that are mostly noise\n",
    "    \"Directions\", \"Private Remarks\",\n",
    "\n",
    "    # Post-sale info\n",
    "    \"Sold Date\", \"Status Change Date\", \"Withdrawal Date\", # Bring back concessions and sold date\n",
    "    \"Cancel Date\", \"Fallthrough Date\", \"Concessions Amount\", \"Concessions4\",\n",
    "\n",
    "    # Too Complicated to deal with at the moment\n",
    "    \"End Date\", \"Marketing Begin Date\", \"Lot Dimensions\", \"Rooms\",\n",
    "    \"Features\", \"Bsmt % Finish\", \"Public Remarks\",\n",
    "\n",
    "    # Uniform Variables\n",
    "    \"Delayed Marketing Exempt Listing\", # N Only\n",
    "    \"State/Province\", # Utah Only\n",
    "    \"Status\", # C Only\n",
    "    \"Property Type\", # Residential Only\n",
    "]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a94043b6",
   "metadata": {},
   "source": [
    "### Columns After the Clean"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "5f9f1edb",
   "metadata": {},
   "outputs": [],
   "source": [
    "land_sales_clean_df = land_sales_df.drop(columns=[c for c in DROP_COLS if c in land_sales_df.columns])"
   ]
  },
