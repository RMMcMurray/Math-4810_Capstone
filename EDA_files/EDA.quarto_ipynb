   ],
   "source": [
    "num_cols = res_clean_df.select_dtypes(include=np.number)\n",
    "plt.figure(figsize=(10,8))\n",
    "plt.imshow(num_cols.corr(), aspect=\"auto\")\n",
    "plt.colorbar()\n",
    "plt.xticks(range(len(num_cols.columns)), num_cols.columns, rotation=90)\n",
    "plt.yticks(range(len(num_cols.columns)), num_cols.columns)\n",
    "plt.title(\"Numeric Feature Correlations\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0584c600",
   "metadata": {},
   "source": [
    "## Prepared Sales\n",
    "\n",
    "### Preclean"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "932a3ab1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['MLS #', 'Acres', 'Basement Finished', 'Under Contract Date', 'Effective Date Of The Listing Agreement', 'List Price', 'Basement Square Feet', 'Sold Concessions', 'Sold Date', 'Sold Price', 'Sold Terms', 'Tax ID', 'Total Bedrooms', 'Total Full Bathrooms', 'Total Half Bathrooms', 'Total Three-quarter Bathrooms', 'Total Fireplaces', 'Total Kitchens', 'Total Laundry Rooms', 'Total Square Feet', 'Year Built', 'Road Condition', 'Accessability', 'Address']\n"
     ]
    }
   ],
   "source": [
    "prepared_df = pd.read_excel(\"data/MLS_Prepared_Sales_For_PUMA.xlsx\")\n",
    "print(list(prepared_df.columns))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "876e54d7",
   "metadata": {},
   "source": [
    "### Post Clean"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "de446337",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['Acres', 'Basement Finished', 'Under Contract Date', 'Effective Date Of The Listing Agreement', 'List Price', 'Basement Square Feet', 'Sold Price', 'Sold Terms', 'Total Bedrooms', 'Total Full Bathrooms', 'Total Half Bathrooms', 'Total Three-quarter Bathrooms', 'Total Fireplaces', 'Total Kitchens', 'Total Laundry Rooms', 'Total Square Feet', 'Year Built', 'Road Condition', 'Accessability']\n"
     ]
    }
   ],
   "source": [
    "DROP_COLS = [\n",
    "    'MLS #', 'Sold Date', 'Sold Concessions', 'Tax ID', 'Address'\n",
    "    ]\n",
    "\n",
    "prepared_clean_df = prepared_df.drop(columns=[c for c in DROP_COLS if c in prepared_df.columns])\n",
    "\n",
    "print(list(prepared_clean_df.columns))"
   ]
