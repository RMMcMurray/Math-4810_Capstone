     ]
    }
   ],
   "source": [
    "# Load data and display columns\n",
    "res_df = pd.read_excel('data/MLS_Residential_Sales.xlsm')\n",
    "print(list(res_df.columns))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b1376d15",
   "metadata": {},
   "source": [
    "### Postclean"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "b052714c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['Sub Type', 'Listing Date', 'Under Contract Date', 'Contingent', 'Original List Price', 'List Price', 'Sold Price', 'How Sold', 'MLS Area', 'St. Dir.', 'City', 'State/Province', 'County', 'Total SqFt', 'Basement SqFt', 'Main SqFt', 'Upstairs SqFt', 'Year Built', 'Lot Acres', 'Total Bedrooms', 'Full Baths', 'Half Baths', 'Garage Type', 'Zoned', 'Total Taxes', 'Subdivision', 'For Sale or Rent', 'HOA', 'Basement', 'Fireplaces', 'Square Foot Source', 'PUD', 'Elementary', 'Senior Community', 'Jr. High', 'Sr. High', 'Listing Type', 'HOA Dues $', 'Garage Capacity', 'Special Taxes (SID)$', 'Lofts', 'Concessions', 'HOA Dues Frequency', 'Owner/Agent', 'Concessions Available', 'Days on Market', 'Bsmt % Finish', 'Fireplaces2', 'Kitchens', 'Laundry', '3/4 Baths', 'Full Baths3', 'Parcel ID Check', 'Road Condition', 'Accessability', 'Address']\n"
     ]
    }
   ],
   "source": [
    "DROP_COLS = [\n",
    "    # IDs / PII / Agents / Metadata\n",
    "    \"List Number\",\"Agency Name\",\"Agency Phone\",\"Agency Email\",\n",
    "    \"Listing Agent\",\"Listing Agent Phone\",\"Listing Agent Email\",\"Co-Listing Agent\",\n",
    "    \"Selling Agency\",\"Selling Agency Phone\",\"Selling Agency Email\",\"Selling Agent\",\n",
    "    \"Selling Agent Phone\",\"Selling Agent Email\",\"Co-Selling Agent\",\"St. #\",\n",
    "    \"Street Name\",\"Street Direction Sfx\",\"Street Suffix\",\"Address 2\",\"Parcel Number\",\n",
    "    \"Owner\",\"Tax Serial #\",\"Photo URL\",\"mod_timestamp\",\"Card Format\",\"Book Section\",\n",
    "    \"Directions\",\"Private Remarks\", \"Postal Code\",\n",
    "\n",
    "    # Post Sell\n",
    "    \"Sold Date\",\"Status Change Date\",\"Withdrawal Date\",\"Cancel Date\",\n",
    "    \"Fallthrough Date\",\"Sold Price Per/SqFt\",\"Concessions Amount\",\n",
    "\n",
    "    # Noisy Could Use with work\n",
    "    \"Contingent Remarks\",\"Public Remarks\",\"Financing Remarks\",\"Utilities\",\"Features\", \"Rooms\",\n",
    "\n",
    "    # Don't want to fix yet\n",
    "    \"End Date\", \"Lot Dimensions\", \"Marketing Begin Date\",\n",
    "    \"Concessions4\",\n",
    "\n",
    "    # Uniform\n",
    "    'Property Type', # Residential Only\n",
    "    'Status', # C only\n",
    "    'State', # Utah Only\n",
    "    \"Delayed Marketing Exempt Listing\", # N Only 1 missing\n",
    "\n",
    "\n",
    "]\n",
    "\n",
    "# Drop columns safely\n",
    "res_clean_df = res_df.drop(columns=[c for c in DROP_COLS if c in res_df.columns])\n",
    "\n",
    "# Print Cleaned Columns\n",
    "print(list(res_clean_df.columns))"
   ]
  },
