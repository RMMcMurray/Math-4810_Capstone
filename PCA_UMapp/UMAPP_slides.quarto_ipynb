        "#| label: run_ai\n",
        "import shap\n",
        "explainer = shap.TreeExplainer(res_rf)\n",
        "# Use a subset of X_test if it's too slow (e.g., res_X_test.iloc[:100])\n",
        "shap_values = explainer.shap_values(res_X_test)"
      ],
      "id": "run_ai",
      "execution_count": null,
      "outputs": []
    },
