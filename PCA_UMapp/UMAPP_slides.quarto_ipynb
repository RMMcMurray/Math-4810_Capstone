      "source": [
        "---\n",
        "title: Numerical PCA and UMAP Analysis\n",
        "author: Ryan McMurray\n",
        "format:\n",
        "  revealjs:\n",
        "    theme: moon\n",
        "    slide-number: true\n",
        "    width: 1600\n",
        "    height: 900\n",
        "    embed-resources: true\n",
        "execute:\n",
        "  echo: false\n",
        "  warning: false\n",
        "  message: false\n",
        "  cache: false\n",
        "---"
      ],
      "id": "f51bdb09"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Setup"
      ],
      "id": "e6074ca9"
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true
      },
      "source": [
        "#| label: setup\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import umap\n",
        "import hdbscan\n",
        "import seaborn as sns\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.decomposition import PCA\n",
        "import matplotlib.colors as colors\n",
        "import shap\n",
        "\n",
        "# Load data\n",
        "res_df = pd.read_csv(\"C:/Users/mcmur/OneDrive/Documents/GitHub/Math-4810_Capstone/data/MLS_Land_Sales.csv\").select_dtypes(include=['number'])\n",
        "puma_df = pd.read_csv(\"C:/Users/mcmur/OneDrive/Documents/GitHub/Math-4810_Capstone/data/PUMA2.csv\").select_dtypes(include=['number'])\n",
        "\n",
        "# Separate data\n",
        "res_df = res_df[res_df['Sold Price'] > 5].copy()\n",
        "puma_df = puma_df[puma_df['Sold Price'] > 5].copy()\n",
        "\n",
        "res_target = res_df['Sold Price'] \n",
        "puma_target = puma_df['Sold Price'] \n",
        "res_target_log = np.log1p(res_df['Sold Price'])\n",
        "puma_target_log = np.log1p(puma_df['Sold Price'])\n",
        "\n",
        "\n",
        "# Drop target-leakage columns\n",
        "res_features = res_df.drop(columns=['Sold Price', 'List Price', 'Original List Price', 'List Number', 'MLS Area', 'Postal Code', 'Sold Price Per/SqFt', 'Total Taxes'])\n",
        "puma_features = puma_df.drop(columns=['Sold Price', 'Adjusted SP', 'List Number'])\n",
        "\n",
        "def get_scaled_data(df):\n",
        "    X = df.fillna(0)\n",
        "    X = X.loc[:, X.var() > 1e-4]\n",
        "    return StandardScaler().fit_transform(X)\n",
        "\n",
        "def get_umap_embedding(scaled_data, nn, md):\n",
        "    \"\"\"Heavy lifting: Runs PCA and UMAP once.\"\"\"\n",
        "    pca_data = PCA(n_components=0.9).fit_transform(scaled_data)\n",
        "    reducer = umap.UMAP(n_neighbors=nn, min_dist=md, random_state=42)\n",
        "    return reducer.fit_transform(pca_data)\n",
        "\n",
        "def get_clusters_from_pca(pca_data, min_size=20):\n",
        "    \"\"\"\n",
        "    Groups data based on high-dimensional PCA space \n",
        "    rather than the 2D UMAP projection.\n",
        "    \"\"\"\n",
        "    clusterer = hdbscan.HDBSCAN(min_cluster_size=min_size, prediction_data=True)\n",
        "    labels = clusterer.fit_predict(pca_data)\n",
        "    return labels\n",
        "\n",
        "def plot_precomputed_umap(embedding, color_source, title, is_price=True):\n",
        "    plt.figure(figsize=(10, 6))\n",
        "    \n",
        "    if is_price:\n",
        "        # NEW: Quantile-based coloring\n",
        "        # This turns prices into their rank (0 to 1)\n",
        "        from scipy.stats import rankdata\n",
        "        price_ranks = rankdata(color_source) / len(color_source)\n",
        "        \n",
        "        scatter = plt.scatter(embedding[:,0], embedding[:,1], \n",
        "                             c=price_ranks, # Use the rank for color\n",
        "                             cmap='viridis', s=10, alpha=0.6)\n",
        "        \n",
        "        # We manually fix the colorbar labels so they show actual dollars\n",
        "        cbar = plt.colorbar(scatter)\n",
        "        cbar.set_label(\"Price Percentile (0 = Cheapest, 1 = Most Expensive)\")\n",
        "    else:\n",
        "        # NEW: Discrete Legend for Clusters\n",
        "        unique_labels = np.unique(color_source)\n",
        "        # Use a qualitative map like 'tab10' or 'Set1' for distinct colors\n",
        "        cmap = plt.get_cmap('tab10', len(unique_labels))\n",
        "        \n",
        "        for i, label in enumerate(unique_labels):\n",
        "            mask = (color_source == label)\n",
        "            label_name = f\"Cluster {label}\" if label != -1 else \"Noise (Outliers)\"\n",
        "            plt.scatter(embedding[mask, 0], embedding[mask, 1], \n",
        "                        label=label_name, s=15, alpha=0.8, color=cmap(i))\n",
        "        \n",
        "        plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left', title=\"Groups\")\n",
        "        \n",
        "    plt.title(title)\n",
        "    plt.show()\n",
        "\n",
        "def get_detailed_summary(df_original, cluster_labels):\n",
        "    \"\"\"Summarizes clusters with top features.\"\"\"\n",
        "    temp_df = df_original.copy()\n",
        "    temp_df['Cluster'] = cluster_labels\n",
        "    \n",
        "    # Filter numeric only for correlation\n",
        "    numeric_df = temp_df.select_dtypes(include=[np.number])\n",
        "    corrs = numeric_df.corr()['Sold Price'].abs().sort_values(ascending=False)\n",
        "    top_features = corrs.index[1:9].tolist()\n",
        "    \n",
        "    cols = ['Sold Price'] + top_features\n",
        "    summary = temp_df[temp_df['Cluster'] != -1].groupby('Cluster')[cols].mean()\n",
        "    return summary.round(2)\n",
        "\n",
        "def plot_scree(scaled_data, title):\n",
        "    pca = PCA().fit(scaled_data)\n",
        "    cum_var = np.cumsum(pca.explained_variance_ratio_)\n",
        "    plt.figure(figsize=(10, 4))\n",
        "    plt.plot(range(1, len(cum_var) + 1), cum_var, marker='o', color='magenta')\n",
        "    plt.axhline(y=0.9, color='white', linestyle='--', label='90% Variance')\n",
        "    plt.title(f\"{title} - Cumulative Explained Variance\")\n",
        "    plt.show()\n",
        "\n",
        "def plot_price_correlation(df_features, target_series, title):\n",
        "    kept_columns = df_features.columns[df_features.fillna(0).var() > 1e-4]\n",
        "    temp_df = df_features[kept_columns].copy()\n",
        "    temp_df['Sold Price'] = target_series\n",
        "    corrs = temp_df.corr()['Sold Price'].sort_values(ascending=False).drop('Sold Price').head(10)\n",
        "    plt.figure(figsize=(10, 5))\n",
        "    corrs.plot.bar(color='gold')\n",
        "    plt.title(f\"Top Features Driving Sold Price: {title}\")\n",
        "    plt.show()\n",
        "\n",
        "def plot_pca_price_correlation(pca_scores, target_series, title):\n",
        "    \"\"\"\n",
        "    Ranks the Principal Components by how strongly they correlate with Sold Price.\n",
        "    This proves if our 'Unsupervised' math matches 'Supervised' value.\n",
        "    \"\"\"\n",
        "    # Create a DataFrame from the PCA transformed data\n",
        "    pc_names = [f'PC{i+1}' for i in range(pca_scores.shape[1])]\n",
        "    pca_df = pd.DataFrame(pca_scores, columns=pc_names)\n",
        "    \n",
        "    # Add the target (reset index to ensure alignment)\n",
        "    pca_df['Target'] = target_series.values \n",
        "    \n",
        "    # Calculate correlations\n",
        "    corrs = pca_df.corr()['Target'].drop('Target')\n",
        "    \n",
        "    # Sort by absolute strength (since a negative correlation is still a strong predictor)\n",
        "    corrs_sorted = corrs.reindex(corrs.abs().sort_values(ascending=False).index).head(10)\n",
        "\n",
        "    plt.figure(figsize=(10, 5))\n",
        "    colors = ['teal' if x > 0 else 'indianred' for x in corrs_sorted]\n",
        "    corrs_sorted.plot.bar(color=colors)\n",
        "    \n",
        "    plt.axhline(0, color='black', linewidth=0.8)\n",
        "    plt.title(f\"Correlation: Principal Components vs. Sold Price ({title})\")\n",
        "    plt.ylabel(\"Correlation Coefficient (r)\")\n",
        "    plt.xlabel(\"Principal Components (Ranked by Strength)\")\n",
        "    plt.show()\n",
        "    \n",
        "    return corrs_sorted\n",
        "\n",
        "def plot_pca_loadings(pca_model, df_features, title):\n",
        "    \"\"\"Uses the already-computed PCA model to show feature importance.\"\"\"\n",
        "    # Identify which columns were kept during scaling\n",
        "    kept_columns = df_features.columns[df_features.fillna(0).var() > 1e-4]\n",
        "    \n",
        "    # Extract loadings (weights) from the pre-existing model\n",
        "    loadings = np.abs(pca_model.components_)\n",
        "    \n",
        "    # Map them back to the column names\n",
        "    pca_importance = pd.Series(\n",
        "        loadings.sum(axis=0), \n",
        "        index=kept_columns\n",
        "    ).sort_values(ascending=False).head(10)\n",
        "\n",
        "    plt.figure(figsize=(10, 5))\n",
        "    pca_importance.plot.bar(color='skyblue')\n",
        "    plt.title(f\"Top 10 Features Defining the Data Structure: {title}\")\n",
        "    plt.ylabel(\"Cumulative PCA Weight\")\n",
        "    plt.xticks(rotation=45, ha='right')\n",
        "    plt.show()\n",
        "\n",
        "def plot_pca_heatmap(pca_model, df_features):\n",
        "    \"\"\"\n",
        "    Plots a heatmap for ALL calculated PCA components with \n",
        "    correlation coefficients labeled in the cells.\n",
        "    \"\"\"\n",
        "    kept_columns = df_features.columns[df_features.fillna(0).var() > 1e-4]\n",
        "    loadings = pca_model.components_\n",
        "    num_pcs = loadings.shape[0]\n",
        "    \n",
        "    loadings_df = pd.DataFrame(\n",
        "        loadings.T, \n",
        "        columns=[f'PC{i+1}' for i in range(num_pcs)], \n",
        "        index=kept_columns\n",
        "    )\n",
        "    \n",
        "    # Adjust width dynamically based on PC count\n",
        "    plt.figure(figsize=(max(12, num_pcs * 1.2), 14))\n",
        "    \n",
        "    # Use 'annot=True' to show coefficients. \n",
        "    # fmt=\".2f\" ensures we don't have long floating point strings.\n",
        "    sns.heatmap(loadings_df, \n",
        "                annot=True, \n",
        "                fmt=\".2f\", \n",
        "                cmap='RdBu_r', \n",
        "                center=0,\n",
        "                annot_kws={\"size\": 8}, # Smaller font to fit in cells\n",
        "                cbar_kws={'label': 'Correlation Coefficient'})\n",
        "    \n",
        "    plt.title(f\"PCA Loadings: Feature Correlation to Principal Components\", fontsize=16)\n",
        "    plt.ylabel(\"Original Features\", fontsize=12)\n",
        "    plt.xlabel(\"Principal Components\", fontsize=12)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "# Stable Math (Scaling & PCA)\n",
        "res_scaled = get_scaled_data(res_features)\n",
        "res_pca_model = PCA(n_components=0.9).fit(res_scaled)\n",
        "res_pca_data = res_pca_model.transform(res_scaled)\n",
        "\n",
        "puma_scaled = get_scaled_data(puma_features)\n",
        "puma_pca_model = PCA(n_components=0.9).fit(puma_scaled)\n",
        "puma_pca_data = puma_pca_model.transform(puma_scaled)"
      ],
      "id": "setup",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true
      },
      "source": [
        "#| label: umap-tuning\n",
        "# This cell controls the UMAPs\n",
        "\n",
        "# --- Residential UMAP Tuning ---\n",
        "res_emb_l = get_umap_embedding(res_scaled, nn=15, md=0.01) \n",
        "res_emb_g = get_umap_embedding(res_scaled, nn=50, md=0.1)\n",
        "\n",
        "# Clustering based on current UMAP/PCA state\n",
        "res_l_clusters = get_clusters_from_pca(res_pca_data, min_size=30)\n",
        "res_g_clusters = get_clusters_from_pca(res_pca_data, min_size=30)\n",
        "\n",
        "# --- PUMA UMAP Tuning ---\n",
        "puma_emb_l = get_umap_embedding(puma_scaled, nn=15, md=0.01)\n",
        "puma_emb_g = get_umap_embedding(puma_scaled, nn=50, md=0.1)\n",
        "\n",
        "puma_l_clusters = get_clusters_from_pca(puma_pca_data, min_size=15)\n",
        "puma_g_clusters = get_clusters_from_pca(puma_pca_data, min_size=15)"
      ],
      "id": "umap-tuning",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
