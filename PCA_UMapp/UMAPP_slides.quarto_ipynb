    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        ":::\n",
        "\n",
        "::: {style=\"font-size: 0.6em;\"}\n",
        "## PUMA UMAP Cluster"
      ],
      "id": "a2142b9a"
    },
    {
      "cell_type": "code",
