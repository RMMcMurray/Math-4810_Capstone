        "  message: false\n",
        "jupyter: python3\n",
        "---\n",
        "\n",
        "## Mixed Data PCA (FAMD)"
      ],
      "id": "b230e249"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: FAMD_Adaptive_Full\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "import prince\n",
        "import glob\n",
        "import os\n",
        "\n",
        "plt.rcParams[\"figure.dpi\"] = 120\n",
        "\n",
        "# --- Columns to drop per dataset ---\n",
        "DROP_COLS_MAP = {\n",
        "    \"MLS_Land_Sales.csv\": [],\n",
        "    \"MLS_Prepared_Sales_For_PUMA.csv\": [],\n",
        "    \"MLS_Residential_Sells.csv\": [],\n",
        "    \"Multi-Family_MLS_Export.csv\": [],\n",
        "}\n",
        "\n",
        "def run_famd_adaptive_drop(X, filename, var_threshold=0.95):\n",
        "    drop_cols = DROP_COLS_MAP.get(filename, [])\n",
        "    X = X.drop(columns=[c for c in drop_cols if c in X.columns], errors=\"ignore\")\n",
        "\n",
        "    # --- Datetime handling ---\n",
        "    for col in X.select_dtypes(include=\"object\"):\n",
        "        try:\n",
        "            X[col] = pd.to_datetime(X[col])\n",
        "        except:\n",
        "            pass\n",
        "    for col in X.select_dtypes(include=\"datetime\"):\n",
        "        X[col+\"_year\"] = X[col].dt.year\n",
        "        X[col+\"_month\"] = X[col].dt.month\n",
        "        X[col+\"_day\"] = X[col].dt.day\n",
        "        X = X.drop(columns=col)\n",
        "\n",
        "    # --- Numeric ---\n",
        "    X_num = X.select_dtypes(include=\"number\")\n",
        "    X_num = X_num.fillna(X_num.mean())\n",
        "\n",
        "    # --- Categorical ---\n",
        "    X_cat = X.select_dtypes(exclude=\"number\").copy()\n",
        "    for col in X_cat.columns:\n",
        "        X_cat[col] = X_cat[col].astype(\"category\")\n",
        "        if \"Missing\" not in X_cat[col].cat.categories:\n",
        "            X_cat[col] = X_cat[col].cat.add_categories(\"Missing\")\n",
        "        X_cat[col] = X_cat[col].fillna(\"Missing\")\n",
        "\n",
        "    X_clean = pd.concat([X_num, X_cat], axis=1)\n",
        "\n",
        "    famd = prince.FAMD(n_components=min(X_clean.shape), random_state=42)\n",
        "    X_famd = famd.fit_transform(X_clean)\n",
        "\n",
        "    cumvar = np.cumsum(famd.eigenvalues_ / famd.eigenvalues_.sum())\n",
        "    k = np.searchsorted(cumvar, var_threshold) + 1\n",
        "\n",
        "    famd = prince.FAMD(n_components=k, random_state=42)\n",
        "    X_famd = famd.fit_transform(X_clean)\n",
        "\n",
        "    return X_famd, famd, cumvar[:k], X_clean\n",
        "\n",
        "\n",
        "def famd_scree_plot(cumvar, title):\n",
        "    plt.figure()\n",
        "    plt.plot(cumvar, marker=\"o\")\n",
        "    plt.axhline(0.95, linestyle=\"--\")\n",
        "    plt.xlabel(\"Components\")\n",
        "    plt.ylabel(\"Cumulative Explained Variance\")\n",
        "    plt.title(title)\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "def famd_heatmap(famd, X_clean, title):\n",
        "    loadings = pd.DataFrame(\n",
        "        famd.column_correlations(X_clean),\n",
        "        index=X_clean.columns,\n",
        "        columns=[f\"Dim{i+1}\" for i in range(famd.n_components)]\n",
        "    )\n",
        "    plt.figure(figsize=(10,6))\n",
        "    sns.heatmap(loadings, cmap=\"coolwarm\", center=0)\n",
        "    plt.title(title)\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# --- Run ---\n",
        "%cd ~\\OneDrive\\Documents\\GitHub\\Math-4810_Capstone\\data\n",
        "results_famd = {}\n",
        "\n",
        "for f in glob.glob(\"*.csv\"):\n",
        "    print(f\"\\nProcessing {f}\")\n",
        "    try:\n",
        "        X = pd.read_csv(f)\n",
        "        X_famd, famd, cumvar, X_clean = run_famd_adaptive_drop(X, f)\n",
        "\n",
        "        famd_scree_plot(cumvar, f\"{f} — Scree Plot\")\n",
        "        famd_heatmap(famd, X_clean, f\"{f} — FAMD Loadings\")\n",
        "\n",
        "        results_famd[f] = X_famd\n",
        "    except Exception as e:\n",
        "        print(f\"Skipped {f}: {e}\")"
      ],
      "id": "FAMD_Adaptive_Full",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## UMAP"
      ],
      "id": "7c23a49c"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: UMAP_FAMD\n",
        "import umap\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "\n",
        "plt.rcParams[\"figure.dpi\"] = 120\n",
        "\n",
        "def run_umap_plot(X, title):\n",
        "    reducer = umap.UMAP(n_neighbors=30, min_dist=0.1, random_state=42)\n",
        "    emb = reducer.fit_transform(X)\n",
        "\n",
        "    plt.figure()\n",
        "    plt.scatter(emb[:,0], emb[:,1], s=10, alpha=0.7)\n",
        "    plt.xlabel(\"UMAP1\")\n",
        "    plt.ylabel(\"UMAP2\")\n",
        "    plt.title(title)\n",
        "    plt.show()\n",
        "\n",
        "# --- Run ---\n",
        "for fname, X_famd in results_famd.items():\n",
        "    print(f\"\\nUMAP for {fname}\")\n",
        "    run_umap_plot(X_famd, fname)"
      ],
      "id": "UMAP_FAMD",
      "execution_count": null,
      "outputs": []
    }
