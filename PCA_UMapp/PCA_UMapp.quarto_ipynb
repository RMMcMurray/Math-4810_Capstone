        "DROP_COLS = [\n",
        "    # IDs / PII / Agents / Metadata\n",
        "    \"List Number\",\"Agency Name\",\"Agency Phone\",\"Agency Email\",\n",
        "    \"Listing Agent\",\"Listing Agent Phone\",\"Listing Agent Email\",\"Co-Listing Agent\",\n",
