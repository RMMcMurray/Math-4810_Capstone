        "\n",
        "    'Listing Date', 'Under Contract Date', 'PUD', 'Parcel ID Check', 'Address', \n",
        "    'St. Dir.'\n",
        "]\n",
        "\n",
        "# Drop columns safely\n",
        "residential = residential.drop(\n",
        "    columns=[c for c in DROP_COLS if c in residential.columns]\n",
        "    )"
      ],
      "id": "2ef51c2b",
