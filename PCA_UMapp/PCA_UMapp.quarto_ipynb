        "    \"Selling Agent Phone\",\"Selling Agent Email\",\"Co-Selling Agent\",\"St. #\",\n",
        "    \"Street Name\",\"Street Direction Sfx\",\"Street Suffix\",\"Address 2\",\"Parcel Number\",\n",
        "    \"Owner\",\"Tax Serial #\",\"Photo URL\",\"mod_timestamp\",\"Card Format\",\"Book Section\",\n",
